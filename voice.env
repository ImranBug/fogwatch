# Voice coach settings (non-secret, committed). Real environment variables override these.
# API keys stay in ../.env. After changing a provider/voice/style, re-record the bank: uv run voice.py --gen --force

# Who generates speech: auto = Gemini first, then OpenAI (the provider with the most cached clips wins ties) | gemini | openai
VOICE_PROVIDER=gemini

# Gemini TTS (needs GEMINI_API_KEY with working billing)
VOICE_GEMINI_MODEL=gemini-3.8-flash-tts
VOICE_GEMINI_VOICE=Alnilam

# OpenAI TTS (current working provider)
VOICE_OPENAI_MODEL=gpt-4o-mini-tts
VOICE_OPENAI_VOICE=cedar

# Delivery instructions: defaults in voice.py (one calm voice for all lines; urgent = firmer, never panicked).
# Override with VOICE_STYLE / VOICE_STYLE_URGENT / VOICE_COMMENTARY_STYLE, then: uv run voice.py --gen --force

# Base playback volume for afplay (0.0-1.0+); the dashboard's volume slider (settings.volume, 0-1) multiplies it
VOICE_VOLUME=1.0

# Thinking prompts (one LLM sentence when something just changed): 1 on / 0 off, max per game (doubled at verbosity high)
VOICE_COMMENTARY=1
VOICE_THINK_MAX=8
# Which LLM writes them: fallback (LLM_FALLBACK_*, measured 1.3-2.1 s) | primary (LLM_*, measured 3.9-5.2 s: too slow, a prompt
# must start within 7 s of its trigger and the voice clip itself takes about 4 s to make)
VOICE_THINK_LLM=fallback

# New clips per day (cost cap)
VOICE_GEN_DAILY=600
